{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Personal Bookkeeping",
  "mainBinaryName": "personal-bookkeeping",
  "version": "../package.json",
  "identifier": "com.deletexiumu.personalbookkeeping",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "个人记账",
        "width": 1100,
        "height": 760,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "category": "Finance",
    "shortDescription": "个人记账",
    "longDescription": "简单、私密的个人记账应用，数据保存在本机。",
    "copyright": "Copyright (c) 2026 deletexiumu",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": ["zh-CN", "en-US"]
      }
    }
  }
}

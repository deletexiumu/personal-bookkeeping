# 陶朱簿后端配置示例。复制为服务器上的 /opt/taozhubu/api.env 后按需修改（这个文件不要提交到仓库）。
# 所有项都可以不填，不填时使用括号里的默认值。

# PostgreSQL 连接串。不填则使用内嵌数据库（PGlite），数据存在 /opt/taozhubu/data
# DATABASE_URL=postgres://taozhubu:密码@数据库主机:5432/taozhubu

# 注册：open 开放注册（默认）、invite 需要邀请码、closed 关闭注册
# REGISTRATION=open

# 登录会话有效天数，期间使用会自动续期（30）
# SESSION_TTL_DAYS=30

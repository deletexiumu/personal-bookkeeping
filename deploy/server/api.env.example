# 陶朱簿后端配置示例。复制为服务器上的 /opt/taozhubu/api.env 后按需修改（这个文件不要提交到仓库）。
# 所有项都可以不填，不填时使用括号里的默认值。

# PostgreSQL 连接串。不填则使用内嵌数据库（PGlite），数据存在 /opt/taozhubu/data
# DATABASE_URL=postgres://taozhubu:密码@数据库主机:5432/taozhubu

# 注册：open 开放注册（默认）、invite 需要邀请码、closed 关闭注册
# REGISTRATION=open

# 登录会话有效天数，期间使用会自动续期（30）
# SESSION_TTL_DAYS=30

# 每个账号在云端最多存多少条记录（各表合计），防止开放注册时被滥用（200000）
# SYNC_MAX_RECORDS=200000

# AI 助手：服务器默认的接入点。不配也行，用户可以在设置里填自己的接入点和代理
# AI_FORMAT=anthropic
# AI_BASE_URL=https://api.anthropic.com
# AI_API_KEY=
# AI_MODEL=claude-opus-5-5
# 访问 AI 接口时走的代理（http://、https://、socks5://）
# AI_PROXY=http://127.0.0.1:7890
# 加密保存用户 API Key 的密钥，不填自动生成在数据目录的 ai-secret.key
# AI_SECRET=
# 每个账号每分钟、每天最多请求 AI 多少次（20 / 300）
# AI_RATE_PER_MINUTE=20
# AI_DAILY_LIMIT=300

# 陶朱簿 Web 的 pigsty-nginx 站点配置模板。域名不写进仓库，部署时用 envsubst 填入：
#   TAOZHUBU_DOMAIN=你的域名 envsubst '${TAOZHUBU_DOMAIN}' < taozhubu.conf.template > /opt/pigsty/nginx/conf.d/taozhubu.conf
# 生成的文件由 pigsty-nginx 容器加载。
# 链路：宿主 nginx stream（:443 ssl_preread + proxy_protocol）→ pigsty-nginx（:4433）→ taozhubu-web:8080
# 证书：certbot dns-cloudflare 签发，位于 /etc/letsencrypt/live/${TAOZHUBU_DOMAIN}/

# HTTP：acme-challenge，其余跳转 HTTPS
server {
    listen 80;
    server_name ${TAOZHUBU_DOMAIN};
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

# HTTPS
server {
    listen 443 ssl proxy_protocol;
    http2 on;
    server_name ${TAOZHUBU_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${TAOZHUBU_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${TAOZHUBU_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;
    access_log /var/log/nginx/taozhubu-access.log;

    # 容器名在每次请求时解析，容器重建或暂未启动时 nginx 也能正常 reload
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $taozhubu_upstream http://taozhubu-web:8080;

    location / {
        proxy_pass $taozhubu_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

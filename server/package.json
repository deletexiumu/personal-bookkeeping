    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}

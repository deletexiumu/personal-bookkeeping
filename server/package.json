{
  "name": "@taozhubu/server",
  "private": true,
  "version": "0.1.0",
  "description": "陶朱簿后端：账号、会话、云同步与开放接口",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/main.ts",
